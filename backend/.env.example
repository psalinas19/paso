# Copy to .env and fill in. Never commit .env.

# Required: Anthropic API key.
ANTHROPIC_API_KEY=sk-ant-...

# Model used for recognition. Overridable so the provider can be swapped
# without touching code (SPEC 12.3).
ANTHROPIC_MODEL=claude-sonnet-5

# Max image edge in pixels before upload. Lower = cheaper and faster,
# but hurts recognition of small handwriting. Feeds the latency budget (D5).
MAX_IMAGE_EDGE=1600

# Per-step SymPy timeout in seconds. On timeout the step becomes `unverifiable`
# rather than `error` (SPEC 6.3).
VERIFY_TIMEOUT_SECONDS=10

# Monthly API spend cap in USD. Phase 0 only reports spend; enforcement
# lands with the backend in phase 2 (SPEC 6.8).
MONTHLY_BUDGET_USD=20

# Cache recognition responses keyed by (image hash, prompt version, model),
# so iterating on the verifier costs nothing.
RECOGNITION_CACHE_ENABLED=true
