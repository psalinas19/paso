# Copy to .env and fill in. Never commit .env.

# Required: Anthropic API key.
ANTHROPIC_API_KEY=sk-ant-...

# Model used for recognition. Overridable so the provider can be swapped
# without touching code (SPEC 12.3).
ANTHROPIC_MODEL=claude-sonnet-5-5

# How hard the model thinks before answering: low, medium, high, xhigh or max.
# Empty = the API default (high). Lower answers faster and costs less, but may
# read or explain worse; measure with `python -m app.eval` before settling.
ANTHROPIC_EFFORT=

# Max image edge in pixels before upload. Lower = cheaper and faster,
# but hurts recognition of small handwriting. Feeds the latency budget (D5).
MAX_IMAGE_EDGE=1600

# Per-step SymPy timeout in seconds. On timeout the step becomes `unverifiable`
# rather than `error` (SPEC 6.3).
VERIFY_TIMEOUT_SECONDS=10

# Monthly API spend cap in USD. Once the month's spend reaches it, the API
# refuses new reviews with a clear message (SPEC 6.8).
MONTHLY_BUDGET_USD=20

# Cache recognition responses keyed by (image hash, prompt version, model),
# so iterating on the verifier costs nothing.
RECOGNITION_CACHE_ENABLED=true

# --- HTTP API (phase 2) ---

# Required to use the API: a long random secret that the notebook sends with
# every request. Without it the API refuses everything. Generate one with:
#   py -3.12 -c "import secrets; print(secrets.token_hex(24))"
# and paste the same value into the app's settings on the iPad.
# Letters and digits only, on purpose: chat apps treat "_" and "*" as formatting
# and silently drop them when the token is copied out of a message.
APP_TOKEN=

# Origins allowed to call the API from a browser, comma-separated.
# capacitor://localhost is the native iPad app.
ALLOWED_ORIGINS=https://paso-libreta.paso-frontend.workers.dev,http://localhost:4173,http://localhost:5173,capacitor://localhost
